// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  name            String         @default("")
  email           String         @unique
  hashed_password String? // null for OAuth-only users
  image           String?
  accounts        Account[]
  refresh_tokens  RefreshToken[]
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
}

model RefreshToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([user_id])
}
enum Provider {
  CREDENTIALS
  GOOGLE
  GITHUB
}

model Account {
  id            String    @id @default(uuid())
  provider_name Provider
  provider_id   String

  user_id        String
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([provider_name, provider_id]) // combination of provider and provider_id must be unique
}

// reason why we have @@unique([provider_name, provider_id])
// Your login flow should be:

// User signs in with Google.
// Search for an Account with:
// provider_name = GOOGLE
// provider_id = abc123
// If found → log the user in.
// If not found → create a new Account (and User if needed).

// So in normal operation, the unique constraint should never be hit.

// It's there as a safety net in case:

// your code has a bug,
// two requests happen at the same time (race condition),
// or someone tries to insert duplicate data manually.

// For example:

// User double-clicks the "Sign in with Google" button.
// The browser sends two requests almost simultaneously.

// Or it can be from different clients:

// The user signs in on their phone and laptop at the same time.

// In both cases, both requests may try to create the same account, and @@unique([provider_name, provider_id]) prevents duplicates

// Example of race condition:
// Time  Request A                  Request B
// ----  ------------------------   ------------------------
// 1     Search → Not found
// 2                                Search → Not found
// 3     Create account
// 4                                Create account ❌

// At time 2, Request A has not finished creating the account yet.

// So Request B searches before the database contains the new row.

// Both think, "No account exists."

// That's why Request B also tries to create one.